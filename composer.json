{
    "name": "hariadi/laravel-myemail",
    "description": "Laravel mail transport for the MYEmail government email delivery service (HTTP API, no SMTP).",
    "keywords": [
        "laravel",
        "mail",
        "mailer",
        "transport",
        "myemail",
        "government"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/mailer": "^7.2 || ^8.0",
        "symfony/mime": "^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hariadi\\MyEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hariadi\\MyEmail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hariadi\\MyEmail\\MyEmailServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}